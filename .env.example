# =============================================================================
# AIA 2.0 OSS - configuracao local
# Copie para .env (make bootstrap faz isso). NUNCA commite o .env.
# A plataforma sobe inteira sem NENHUMA chave de API, usando o Ollama.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PLATFORM_BASE_URL=http://localhost:8080

# --- Infraestrutura local (docker-compose) -----------------------------------
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=aia
MINIO_ROOT_PASSWORD=aia-local-dev-only
QDRANT_URL=http://qdrant:6333

# --- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
# Conteudo de prompt e resposta so e capturado com opt-in e apos redacao (doc 02, secao 11).
AIA_CONTENT_CAPTURE=false

# --- Identidade --------------------------------------------------------------
# Em producao troque por um segredo do Vault/Infisical e habilite OIDC externo.
IDENTITY_ISSUER=http://identity:3001
IDENTITY_JWKS_URL=http://identity:3001/.well-known/jwks.json
IDENTITY_SIGNING_KEY_PASSPHRASE=troque-isto-em-producao
IDENTITY_ACCESS_TOKEN_TTL=3600
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@aia.local
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# OIDC externo opcional (Keycloak, Google, Auth0). Vazio = emissor proprio.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Credenciais de servico --------------------------------------------------
# Sem identidade gerenciada de nuvem, cada servico se autentica no aia-identity
# pelo grant client_credentials. Troque estes valores em producao.
ROUTER_CLIENT_SECRET=dev-router-secret-troque-em-producao
AGENT_RUNTIME_CLIENT_SECRET=dev-agent-secret-troque-em-producao

# --- Servicos internos -------------------------------------------------------
GOVERNANCE_URL=http://governance:3002
GUARDRAILS_URL=http://guardrails:8001
INFERENCE_ROUTER_URL=http://inference-router:3000

# =============================================================================
# Provedores de modelo
# Deixe a chave vazia para desabilitar o provedor. Ollama nao precisa de chave.
# Cada provedor declara uma ZONA DE DADOS: o roteamento por classificacao
# (ADR-010) usa isso para impedir que dado sensivel saia da maquina.
# =============================================================================

# --- Ollama (local, custo zero, zona de dados: local) ------------------------
OLLAMA_BASE_URL=http://ollama:11434
# 1b cabe na memoria padrao do Docker Desktop (~2,5 GiB). Com mais RAM
# disponivel, llama3.2:3b ou qwen2.5:7b dao respostas melhores.
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI (zona de dados: us) ----------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini (zona de dados: global) -----------------------------------
# Endpoint, versao e path sao configuraveis porque a API do Gemini muda de forma.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Anthropic (zona de dados: us) -------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# =============================================================================
# Politicas de plataforma
# =============================================================================
# Teto de tokens por request quando o Redis esta indisponivel (budget_unverified).
BUDGET_UNVERIFIED_MAX_TOKENS=2000
# TTL do cache local de politicas do governance, em segundos.
POLICY_CACHE_TTL_SECONDS=30
# Cache semantico: limiar de similaridade e TTL.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_MIN_SIMILARITY=0.97
SEMANTIC_CACHE_TTL_SECONDS=3600
