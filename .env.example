# =============================================================================
# AIA 2.0 OSS - local configuration
# Copy this to .env (make bootstrap does it). NEVER commit .env.
# The whole platform starts with NO API key at all, using Ollama.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
PLATFORM_BASE_URL=http://localhost:8080

# --- Local infrastructure (docker-compose) -----------------------------------
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=aia
MINIO_ROOT_PASSWORD=aia-local-dev-only
QDRANT_URL=http://qdrant:6333

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
# Prompt and response content is captured only with opt-in and after redaction
# (reference doc 02 §11).
AIA_CONTENT_CAPTURE=false

# --- Identity ----------------------------------------------------------------
# In production, swap this for a secret from Vault/Infisical and enable external OIDC.
IDENTITY_ISSUER=http://identity:3001
# Where aia-identity actually IS, when that differs from the issuer claim --
# running the services outside the compose network, for instance, where
# `http://identity:3001` resolves to nothing. Defaults to IDENTITY_ISSUER.
#   IDENTITY_URL=http://localhost:3001
IDENTITY_URL=
IDENTITY_JWKS_URL=http://identity:3001/.well-known/jwks.json
IDENTITY_SIGNING_KEY_PASSPHRASE=change-this-in-production
IDENTITY_ACCESS_TOKEN_TTL=3600
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@aia.local
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# Optional external OIDC (Keycloak, Google, Auth0). Empty = our own issuer.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Service credentials -----------------------------------------------------
# With no managed cloud identity, each service authenticates against aia-identity
# through the client_credentials grant. Change these values in production.
ROUTER_CLIENT_SECRET=dev-router-secret-change-in-production
AGENT_RUNTIME_CLIENT_SECRET=dev-agent-secret-change-in-production

# --- Internal services -------------------------------------------------------
GOVERNANCE_URL=http://governance:3002
GUARDRAILS_URL=http://guardrails:8001
INFERENCE_ROUTER_URL=http://inference-router:3000

# =============================================================================
# Model providers
# Leave a key empty to disable that provider. Ollama needs no key.
# Each provider declares a DATA ZONE: classification-based routing (ADR-010) uses
# it to keep sensitive data from leaving the machine.
# =============================================================================

# --- Ollama (local, zero cost, data zone: local) -----------------------------
OLLAMA_BASE_URL=http://ollama:11434
# 1b fits in Docker Desktop's default memory (~2.5 GiB). With more RAM
# available, llama3.2:3b or qwen2.5:7b give better answers.
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# The local model needs ~2.2 GiB of the Docker VM to itself, and the rest of the
# platform uses around 1.4 GiB — the observability stack alone is 700 MiB. Give
# Docker at least 6 GiB, or the model fails to load with "requires more system
# memory than is available" and every alias silently falls over to a provider
# that needs a key. On a tight machine, `docker compose stop lgtm` frees enough
# to run the model, at the cost of traces.
#
# How long Ollama keeps a model in memory. -1 never unloads it, which is what
# you want while the console is in use: reloading costs tens of seconds on CPU.
# Set a duration ("5m") to trade responsiveness back for memory.
OLLAMA_KEEP_ALIVE=-1
#
# A container cannot reach the GPU on macOS or Windows, so Ollama runs on CPU
# there and a reply takes tens of seconds. To use a native install instead --
# Metal on a Mac, and far faster -- run `ollama serve` on the host, comment the
# ollama service out of the compose file, and point the router at it:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- OpenAI (data zone: us) --------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini (data zone: global) ---------------------------------------
# Endpoint, version, protocol and model are all configurable because the Gemini
# API keeps changing shape, and Google retires models for NEW keys while older
# keys keep working. If a call comes back 404 saying the model "is no longer
# available to new users", change the model here rather than the adapter.
#
# `gemini-flash-latest` is an alias that tracks the current flash model, which
# is why it is the default: a pinned version rots the moment Google retires it.
# --- Gemini -----------------------------------------------------------------
# One key per slot. A quota is per key, so three of them triple the ceiling and
# give failover for free: the retry the router already performs after a 429
# lands on the next key.
#
# Paste the values here and nothing else -- the router uses every slot that is
# filled, skips the empty ones, and ignores a key pasted into two of them.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# For more than three: comma separated. Used together with the slots above.
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
# `generate-content` is the long-standing endpoint and the one this adapter
# speaks correctly. `interactions` is the newer interface, but the current
# models expect a `step_list` body there that the adapter does not build yet.
GEMINI_PROTOCOL=generate-content
GEMINI_CHAT_MODEL=gemini-flash-latest
# A stronger model for `chat-advanced` -- and the evaluation judge, which must
# not be the model under test.
GEMINI_ADVANCED_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Anthropic (data zone: us) -----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# =============================================================================
# Platform policies
# =============================================================================
# Per-request token ceiling while Redis is unavailable (budget_unverified).
BUDGET_UNVERIFIED_MAX_TOKENS=2000
# TTL of the local cache of governance policies, in seconds.
POLICY_CACHE_TTL_SECONDS=30
# Semantic cache: similarity threshold and TTL.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_MIN_SIMILARITY=0.97
SEMANTIC_CACHE_TTL_SECONDS=3600
