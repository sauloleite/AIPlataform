{
  "name": "@aia/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente da API canonica da plataforma",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
