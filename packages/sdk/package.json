    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@aia/contracts": "workspace:*",
    "@aia/errors": "workspace:*"
  }
}
