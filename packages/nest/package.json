{
  "name": "@aia/nest",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTTP glue for the NestJS services: Problem Details, auth, tenant, health",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@aia/auth": "workspace:*",
    "@aia/errors": "workspace:*",
    "@aia/telemetry": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@opentelemetry/api": "^1.9.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.1",
    "vitest": "^4.1.11"
  }
}
