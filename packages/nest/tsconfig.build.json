{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../auth/tsconfig.build.json"
    },
    {
      "path": "../errors/tsconfig.build.json"
    },
    {
      "path": "../telemetry/tsconfig.build.json"
    }
  ],
  "//": "BUILD config: emits to dist/. Tests are excluded so they stay out of the image."
}
