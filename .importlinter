# The Clean Architecture dependency rule for the Python services (reference doc
# 03 §3.1). Mirrors .dependency-cruiser.cjs on the TypeScript side. Fails the build.

[importlinter]
root_packages =
    aia_auth
    aia_contracts
    aia_fastapi
    aia_errors
    aia_messaging
    aia_resilience
    aia_telemetry
    aia_sdk
    guardrails
    agent_runtime
    evaluation
# Needed because the contracts also forbid external packages (fastapi, redis).
include_external_packages = True

[importlinter:contract:guardrails-layers]
name = guardrails honours the dependency rule
type = layers
layers =
    presentation
    application
    domain
containers =
    guardrails
exhaustive = False

[importlinter:contract:agent-runtime-layers]
name = agent-runtime honours the dependency rule
type = layers
layers =
    presentation
    application
    domain
containers =
    agent_runtime
exhaustive = False

[importlinter:contract:evaluation-layers]
name = evaluation honours the dependency rule
type = layers
layers =
    presentation
    application
    domain
containers =
    evaluation
exhaustive = False

[importlinter:contract:guardrails-domain-without-frameworks]
name = the guardrails domain knows no framework and no I/O
type = forbidden
source_modules =
    guardrails.domain
forbidden_modules =
    aia_fastapi
    fastapi
    starlette
    pymongo
    redis
    httpx
    presidio_analyzer
    presidio_anonymizer
    guardrails.infrastructure
    guardrails.presentation

[importlinter:contract:agent-runtime-domain-without-frameworks]
name = the agent-runtime domain knows no framework and no I/O
type = forbidden
source_modules =
    agent_runtime.domain
forbidden_modules =
    aia_fastapi
    fastapi
    starlette
    pymongo
    redis
    httpx
    agent_runtime.infrastructure
    agent_runtime.presentation

[importlinter:contract:evaluation-domain-without-frameworks]
name = the evaluation domain knows no framework and no I/O
type = forbidden
source_modules =
    evaluation.domain
forbidden_modules =
    aia_fastapi
    fastapi
    starlette
    pymongo
    redis
    httpx
    yaml
    evaluation.infrastructure
    evaluation.presentation

[importlinter:contract:application-without-adapters]
name = use cases depend on ports, never on adapters
type = forbidden
source_modules =
    guardrails.application
    agent_runtime.application
    evaluation.application
forbidden_modules =
    guardrails.infrastructure
    agent_runtime.infrastructure
    evaluation.infrastructure
    fastapi
    starlette

[importlinter:contract:libraries-do-not-know-services]
name = shared libraries know no service
type = forbidden
source_modules =
    aia_auth
    aia_contracts
    aia_errors
    aia_fastapi
    aia_messaging
    aia_resilience
    aia_sdk
    aia_telemetry
forbidden_modules =
    guardrails
    agent_runtime
    evaluation
